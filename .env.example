# Copia este ficheiro para .env e preenche os valores.
# O .env está no .gitignore e NUNCA deve ser versionado.

# Base de dados local (usada pelo docker-compose e pela aplicação)
POSTGRES_DB=ligadospobres
POSTGRES_USER=liga
POSTGRES_PASSWORD=troca-isto
DB_URL=jdbc:postgresql://localhost:5432/ligadospobres
DB_USER=liga
DB_PASSWORD=troca-isto

# Primeiro administrador, criado apenas se ainda não existir nenhum.
# Depois de entrares: muda a password e apaga ADMIN_PASSWORD daqui.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Envio de email (recuperação de password), pelo Resend.
# A chave é criada em resend.com/api-keys. O remetente tem de ser um endereço
# de um domínio já verificado lá — sem isso, o Resend recusa enviar para
# terceiros e só a tua própria caixa recebe.
# Sem estas duas variáveis a aplicação arranca à mesma, mas as mensagens só vão
# para o log e ninguém consegue recuperar a password.
EMAIL_CHAVE=
EMAIL_REMETENTE=Quota <noreply@liga.joaoazul.dev>

# Endereço público da aplicação, usado no link do email de recuperação.
APP_URL=http://localhost:8080

# Em produção: COOKIE_SECURE=true
COOKIE_SECURE=false

# Porta local onde a aplicação escuta. O proxy do servidor fala com esta.
# Só é preciso mudar se a 8080 já estiver ocupada por outra coisa.
PORTA_APP=8080
