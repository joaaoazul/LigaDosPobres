# Copia este ficheiro para .env e preenche os valores.
# O .env está no .gitignore e NUNCA deve ser versionado.

# Base de dados local (usada pelo docker-compose e pela aplicação)
POSTGRES_DB=ligadospobres
POSTGRES_USER=liga
POSTGRES_PASSWORD=troca-isto
DB_URL=jdbc:postgresql://localhost:5432/ligadospobres
DB_USER=liga
DB_PASSWORD=troca-isto

# Código de convite exigido para criar contas de gestor.
# Gera um com: openssl rand -hex 16
REGISTO_CODIGO=

# Em produção: COOKIE_SECURE=true
COOKIE_SECURE=false
